# the API's public key (same name as in the API's .env); server-side only
PUBLIC_API_KEY=
# optional, defaults to http://localhost:8080
API_URL=

# MyAnimeList, for /life/anime; server-side only.
# Client id: https://myanimelist.net/apiconfig (create an app, any type)
MAL_CLIENT_ID=
# the account whose public anime and manga lists are shown
MAL_USERNAME=
